import pygame as pg
import time
from pygame.math import Vector2, Vector3

assert pg.Vector2 is Vector2 and pg.Vector3 is Vector3
axis = Vector2(3, 4)
assert axis.length() == 5
assert axis.dot((2, 1)) == 10
assert axis.cross((2, 1)) == -5
assert axis.normalize().is_normalized()
assert abs(Vector2(1, 0).angle_to((0, 1)) - 90) < 0.001
rotated = axis.rotate(90)
assert abs(rotated.x + 4) < 0.001 and abs(rotated.y - 3) < 0.001

a = Vector3(1, 0, 0)
b = Vector3(0, 1, 0)
assert a.cross(b) == Vector3(0, 0, 1)
assert a.lerp(b, 0.5) == Vector3(0.5, 0.5, 0)
assert a.distance_squared_to(b) == 2
assert (2 * a + b) == Vector3(2, 1, 0)

screen = pg.display.set_mode()
screen.fill((8, 16, 24))
origin = Vector2(156, 125)
for value, color in ((axis, "cyan"), (rotated, "yellow")):
    end = origin + value * 20
    pg.draw.line(screen, color, tuple(origin), tuple(end), 3)
    pg.draw.circle(screen, color, tuple(end), 5)
pg.draw.circle(screen, "white", tuple(origin), 4)
pg.display.flip()
time.sleep_ms(3500)
print("Pygame vector checks passed")
