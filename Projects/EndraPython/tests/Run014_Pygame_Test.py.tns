import display
import pygame as pg

pg.init()
screen = pg.display.set_mode((320, 240))
clock = pg.time.Clock()
background = (16, 28, 43)
field = pg.Rect(16, 56, 288, 168)

player = pg.sprite.Sprite()
player.image = pg.Surface((18, 18))
player.image.fill("magenta")
player.image.set_colorkey("magenta")
pg.draw.rect(player.image, (78, 235, 190), (2, 2, 14, 14))
pg.draw.rect(player.image, (218, 255, 246), (6, 6, 6, 6))
player.rect = player.image.get_rect(center=(158, 142))

token = pg.sprite.Sprite()
token.image = pg.Surface((12, 12))
token.image.fill((255, 211, 112))
token.rect = token.image.get_rect(center=(235, 142))
targets = pg.sprite.Group(token)
scene = pg.sprite.Group(player, token)
score = frames = 0
running = True
try:
  while running and frames < 240:
    for event in pg.event.get():
      if event.type == pg.QUIT:
        running = False
    if not running:
      break
    held = pg.key.get_pressed()
    player.rect.move_ip(4 * (held[pg.K_RIGHT] - held[pg.K_LEFT]),
                        4 * (held[pg.K_DOWN] - held[pg.K_UP]))
    player.rect.clamp_ip(field)
    if pg.sprite.spritecollide(player, targets, True):
      score += 1
    screen.fill(background)
    pg.draw.rect(screen, (37, 57, 76), field)
    pg.draw.rect(screen, (90, 142, 160), field, 1)
    pg.draw.line(screen, (72, 106, 117), (160, 57), (160, 222))
    display.draw_string(16, 8, "EndraPython Pygame", (218, 255, 246), "large")
    display.draw_string(16, 37, "Arrows move  |  Esc exits", (196, 218, 226), "small")
    scene.draw(screen)
    pg.display.flip()
    frames += 1
    clock.tick(30)
except KeyboardInterrupt:
  pass
pg.quit()
print("Pygame frames:", frames)
print("Tokens collected:", score)
